generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MemberRole {
  admin
  staff
}

enum RegistryStatus {
  active
  archived
}

enum PolicyStatus {
  unknown
  requested
  verified
  paid
  denied
}

model Org {
  id                       String   @id @default(uuid())
  name                     String
  createdByClerkUserId     String

  includedActiveRegistries Int      @default(5)

  stripeCustomerId         String?
  stripeSubscriptionId     String?
  stripeSubscriptionStatus String   @default("none") // none|trialing|active|past_due|canceled|unpaid|incomplete|paused
  stripeCurrentPeriodEnd   DateTime?
  stripeHasPaymentMethod   Boolean  @default(false)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  members                  OrgMember[]
  registries               Registry[]
  files                    FileAsset[]
  audit                    AuditLog[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model OrgMember {
  orgId       String
  clerkUserId String
  role        MemberRole @default(admin)
  createdAt   DateTime   @default(now())

  org         Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, clerkUserId])
  @@index([clerkUserId])
}

model Registry {
  id         String        @id @default(uuid())
  orgId      String
  name       String
  status     RegistryStatus @default(active)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?

  org        Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policies   Policy[]
  files      FileAsset[]
  audit      AuditLog[]

  @@index([orgId, status])
}

model Policy {
  id            String      @id @default(uuid())
  orgId         String
  registryId    String

  carrier       String?
  policyNumber  String?
  insuredName   String?
  ownerName     String?
  beneficiary   String?
  faceAmount    Decimal?    @db.Decimal(12, 2)

  status        PolicyStatus @default(unknown)
  notes         String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  registry      Registry     @relation(fields: [registryId], references: [id], onDelete: Cascade)
  files         FileAsset[]  @relation("PolicyFiles")

  @@index([orgId])
  @@index([registryId])
  @@index([status])
}

model FileAsset {
  id                    String   @id @default(uuid())
  orgId                 String
  registryId            String?
  policyId              String?

  bucket                String   @default("heirvault-files")
  storagePath           String   @unique
  originalName          String
  mimeType              String
  byteSize              Int

  category              String   @default("uploads") // policies|proofs|uploads|correspondence
  uploadedByClerkUserId String

  createdAt             DateTime @default(now())

  org                   Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registry              Registry? @relation(fields: [registryId], references: [id], onDelete: SetNull)
  policy                Policy?  @relation("PolicyFiles", fields: [policyId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([registryId])
  @@index([policyId])
}

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String
  registryId String?
  actorClerkUserId String?

  action     String
  targetType String
  targetId   String?
  meta       Json?

  createdAt  DateTime @default(now())

  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registry   Registry? @relation(fields: [registryId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([registryId])
  @@index([action])
}
