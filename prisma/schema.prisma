generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}


enum MemberRole {
  admin
  staff
}

enum RegistryStatus {
  active
  archived
}

enum PolicyStatus {
  unknown
  requested
  verified
  paid
  denied
}

enum UserRole {
  attorney
  client
  admin
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String
  firstName String?
  lastName  String?
  role      UserRole @default(attorney)
  roles     String[] @default(["USER"])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  barNumber String?

  @@index([clerkId])
  @@index([email])
}

model Org {
  id                       String   @id @default(uuid())
  name                     String
  createdByClerkUserId     String

  includedActiveRegistries Int      @default(5)

  stripeCustomerId         String?
  stripeSubscriptionId     String?
  stripeSubscriptionStatus String   @default("none") // none|trialing|active|past_due|canceled|unpaid|incomplete|paused
  stripeCurrentPeriodEnd   DateTime?
  stripeHasPaymentMethod   Boolean  @default(false)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  members                  OrgMember[]
  registries               Registry[]
  files                    FileAsset[]
  audit                    AuditLog[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model OrgMember {
  orgId       String
  clerkUserId String
  role        MemberRole @default(admin)
  createdAt   DateTime   @default(now())

  org         Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, clerkUserId])
  @@index([clerkUserId])
}

model Registry {
  id         String        @id @default(uuid())
  orgId      String
  name       String
  status     RegistryStatus @default(active)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?

  org        Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policies   Policy[]
  files      FileAsset[]
  audit      AuditLog[]

  @@index([orgId, status])
}

model Policy {
  id            String      @id @default(uuid())
  orgId         String
  registryId    String

  carrier       String?
  policyNumber  String?
  insuredName   String?
  ownerName     String?
  beneficiary   String?
  faceAmount    Decimal?    @db.Decimal(12, 2)

  status        PolicyStatus @default(unknown)
  notes         String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  registry      Registry     @relation(fields: [registryId], references: [id], onDelete: Cascade)
  files         FileAsset[]  @relation("PolicyFiles")

  @@index([orgId])
  @@index([registryId])
  @@index([status])
}

model FileAsset {
  id                    String   @id @default(uuid())
  orgId                 String
  registryId            String?
  policyId              String?

  bucket                String   @default("heirvault-files")
  storagePath           String   @unique
  originalName          String
  mimeType              String
  byteSize              Int

  category              String   @default("uploads") // policies|proofs|uploads|correspondence
  uploadedByClerkUserId String

  createdAt             DateTime @default(now())

  org                   Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registry              Registry? @relation(fields: [registryId], references: [id], onDelete: SetNull)
  policy                Policy?  @relation("PolicyFiles", fields: [policyId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([registryId])
  @@index([policyId])
}

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String
  registryId String?
  actorClerkUserId String?

  action     String
  targetType String
  targetId   String?
  meta       Json?

  createdAt  DateTime @default(now())

  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registry   Registry? @relation(fields: [registryId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([registryId])
  @@index([action])
}

// Standalone client payment flow models
model ClientRegistry {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // who paid / who owns it
  clientEmail String
  clientName  String?
  status      String   @default("ACTIVE") // ACTIVE | COMPLETE
  completedAt DateTime?

  // Stripe
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  // PDF summary stored in Supabase Storage
  summaryBucket String?
  summaryPath   String?

  files ClientFileAsset[]

  @@index([clientEmail])
  @@index([stripeCheckoutSessionId])
}

model ClientFileAsset {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  registryId String
  registry   ClientRegistry @relation(fields: [registryId], references: [id], onDelete: Cascade)

  originalName String
  mimeType     String
  sizeBytes    Int?

  storageBucket String
  storagePath   String

  status String @default("UPLOADED") // PENDING | UPLOADED | FAILED

  @@index([registryId])
  @@index([storagePath])
}
model OutreachLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  orgId     String?
  email     String
  firmName  String?
  attorneyName String?

  subject   String
  body      String?

  mode      String   @default("bulk") // single|bulk
  status    String   @default("QUEUED") // QUEUED|SENT|FAILED|SKIPPED
  provider  String   @default("resend")
  providerMsgId String?
  errorMessage String?
}
